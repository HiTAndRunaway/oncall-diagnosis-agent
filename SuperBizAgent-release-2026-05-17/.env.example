# ============================================================
# SuperBizAgent 环境变量模板
# 复制为 .env 或设置到系统环境变量（生产环境建议用密钥管理服务）
# ============================================================

# ---- DashScope（应用直连模式 litellm.enabled=false 时使用）----
# 阿里云百炼 DashScope API Key
DASHSCOPE_API_KEY=

# ---- liteLLM 网关（litellm.enabled=true 时使用）----
# 网关管理密钥（litellm/config.yaml 的 master_key）
LITELLM_MASTER_KEY=

# 应用访问网关用的虚拟密钥（按业务域分配：chat/aiops/embedding/lightweight）
# 对应 application.yml 的 litellm.api-key
LITELLM_API_KEY=

# 可选：liteLLM spend logs / 预算持久化（MVP 可不设置）
# DATABASE_URL=

# ---- 其他可选 ----
# MCP 客户端开关（本地开发可关闭避免启动时连接外部 MCP 端点）
# MCP_CLIENT_ENABLED=false
